{
	"name": "uieats — UIUC dining with allergens",
	"short_name": "uieats",
	"description": "University of Illinois dining menus, with every dish flagged against the allergens you register.",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"orientation": "portrait",
	"background_color": "#ffffff",
	"theme_color": "#ffffff",
	"categories": ["food", "utilities"],
	"icons": [
		{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" },
		{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
		{ "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
		{
			"src": "/icon-maskable-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		}
	],
	"shortcuts": [
		{
			"name": "Search for a dish",
			"short_name": "Search",
			"url": "/search",
			"icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
		},
		{
			"name": "Your allergens",
			"short_name": "Allergens",
			"url": "/settings/allergens",
			"icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
		}
	]
}
