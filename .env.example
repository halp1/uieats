# --- Database ---------------------------------------------------------------
# Defaults to <cwd>/data/uieats.db when unset.
DATABASE_PATH=

# --- Email (login codes) ----------------------------------------------------
# Without a key, the ConsoleMailer prints codes to stdout. Real mail is only
# sent when NODE_ENV=production or EMAIL_LIVE=1.
RESEND_API_KEY=
EMAIL_FROM="uieats <login@uieats.example>"
EMAIL_LIVE=

# --- Auth -------------------------------------------------------------------
# WebAuthn relying-party. RP_ID must be the bare hostname (no scheme, no port).
ORIGIN=http://localhost:5173
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=uieats

# --- Scraper ----------------------------------------------------------------
NETNUTRITION_BASE_URL=https://eatsmart.housing.illinois.edu/NetNutrition/46
# Identify yourself. Upstream is a university server with no API contract.
SCRAPER_USER_AGENT="uieats/0.1 (+https://github.com/yourname/uieats)"
SCRAPE_DAYS_AHEAD=21
SCRAPE_DAYS_BEHIND=1
SCRAPER_CONCURRENCY=3
SCRAPER_MIN_INTERVAL_MS=150
SCRAPER_TIMEOUT_MS=20000
# full = one nutrition label per item instance (default)
# dedupe = one per normalized (name, serving size)
RECIPE_MODE=full
# Safety valves.
SCRAPER_DRY_RUN=
SCRAPER_MAX_REQUESTS=

# --- Tests ------------------------------------------------------------------
# Set to 1 to enable the opt-in live smoke test against the real site.
LIVE_SCRAPE_TEST=
