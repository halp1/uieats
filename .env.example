# Every variable uieats reads, and nothing it does not.
#
# An example file listing knobs the code ignores is worse than no example file:
# someone sets one, nothing happens, and they go looking for the bug somewhere
# else. If a name is here, `grep process.env` finds it in the source.
#
# NOTE ON DEV: `vite dev` does not load .env into process.env -- Vite exposes it
# through import.meta.env instead -- so in development these are unset unless you
# export them in your shell. That is why login codes print to the console in dev
# and only go out through Resend in production, where the process environment is
# real.

# --- Database ---------------------------------------------------------------
# Defaults to <cwd>/data/uieats.db. Must be LOCAL DISK: WAL is unsafe over NFS,
# and the scraper writes while the web process reads.
DATABASE_PATH=

# Where the numbered .sql migrations live. Only needed if the deployment moves
# them away from src/lib/server/db/migrations -- see db/migrate.ts.
MIGRATIONS_DIR=

# --- Email (login codes) ----------------------------------------------------
# With no key, codes print to the console. That is the dev setup and a broken
# production one, so set this deliberately.
RESEND_API_KEY=
MAIL_FROM="uieats <onboarding@resend.dev>"

# --- Scraper ----------------------------------------------------------------
NETNUTRITION_BASE_URL=https://eatsmart.housing.illinois.edu/NetNutrition/46

# Identify the project with a contact URL. This is an unauthenticated scrape of
# a university server with no API contract; being reachable is the least it
# deserves.
SCRAPER_USER_AGENT="uieats/0.1 (+https://github.com/yourname/uieats)"

# Window. Upstream offers ~28 days ahead; each extra day is ~110 menus.
SCRAPE_DAYS_AHEAD=21
SCRAPE_DAYS_BEHIND=1

# Politeness. 3 concurrent at 150 ms apart is ~6 req/s. Do not raise these
# without a reason you would be willing to give the university.
SCRAPER_CONCURRENCY=3
SCRAPER_MIN_INTERVAL_MS=150
SCRAPER_TIMEOUT_MS=20000
SCRAPER_MAX_ATTEMPTS=3

# full   = one nutrition label per item instance (the default, ~31k fetches on a
#          first run, ~10 min/night in steady state because detailOid is a
#          stable cache key)
# dedupe = one per normalized (dish, serving size); a tenth of the requests, at
#          the cost of assuming a dish is identical wherever it appears
RECIPE_MODE=full

# Kill switches.
SCRAPER_DRY_RUN=
SCRAPER_MAX_REQUESTS=

# --- Tests ------------------------------------------------------------------
# 1 enables the opt-in live smoke test: six real requests against the real site,
# asserting shape invariants only. `bun run test:live`.
LIVE_SCRAPE_TEST=

# --- Read by adapter-node, not by this app ----------------------------------
#
# These do not appear in `grep process.env` because the built server reads them,
# not our code. In production they are not optional -- see DEPLOY.md.
#
# ORIGIN is the one that bites: SvelteKit checks the Origin header against the
# URL it believes it is serving, and behind a reverse proxy it cannot work that
# out alone. Unset, EVERY form action returns 403 while pages still render
# perfectly -- so it presents as "the login button does nothing".
ORIGIN=

# So a login attempt is recorded against the real client rather than the proxy.
# Only set these when a proxy you trust is in front; the header is spoofable.
ADDRESS_HEADER=
XFF_DEPTH=

# Container timezone. The app does NOT need it -- campusToday() pins
# America/Chicago itself and returns the same answer in any container. Cron
# does: a nightly schedule written in campus time has to be interpreted in it.
TZ=America/Chicago

# NOT USED, and deliberately absent: WEBAUTHN_RP_ID / WEBAUTHN_RP_NAME. The
# relying party is derived from each request's own URL -- which is why a correct
# ORIGIN gives a correct RP id for free, and a wrong one is not an error but
# credentials that silently stop working.
